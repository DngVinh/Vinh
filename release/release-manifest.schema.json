{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseManifest",
  "description": "Schema for immutable production release manifest binding source revision, artifact digests, approvals, gates, and evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "source_revision",
    "artifact_digest",
    "environment",
    "migration_version",
    "rollback_plan",
    "approvals",
    "gates",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel-[a-zA-Z0-9_-]+$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "environment": {
      "type": "string",
      "enum": ["staging", "production"]
    },
    "migration_version": {
      "type": "string",
      "minLength": 1
    },
    "rollback_plan": {
      "type": "object",
      "required": ["strategy", "steps"],
      "properties": {
        "strategy": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "approved_by", "approved_at", "signature"],
        "properties": {
          "role": { "type": "string" },
          "approved_by": { "type": "string" },
          "approved_at": { "type": "string" },
          "signature": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "evaluated_at"],
        "properties": {
          "gate_id": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "evaluated_at": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "description"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
