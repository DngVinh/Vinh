{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus247.example/schemas/citations/citation.schema.json",
  "title": "Citation",
  "description": "Resolvable evidence pointer for a policy or procedure assertion.",
  "x-document-control": {
    "document_id": "DATA-SCHEMA-CITATION-001",
    "version": "1.0.0",
    "status": "reviewed",
    "owner": "Data Architect",
    "approvers": ["Knowledge Lead", "AI Quality Lead"],
    "last_updated": "2026-09-21"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "citation_id",
    "source_id",
    "document_version_id",
    "source_title",
    "canonical_uri",
    "version_label",
    "locator",
    "source_status"
  ],
  "properties": {
    "citation_id": {"$ref": "#/$defs/uuidV7"},
    "source_id": {"$ref": "#/$defs/uuidV7"},
    "document_version_id": {"$ref": "#/$defs/uuidV7"},
    "chunk_id": {"$ref": "#/$defs/uuidV7"},
    "source_title": {"type": "string", "minLength": 1, "maxLength": 300},
    "canonical_uri": {"type": "string", "format": "uri", "maxLength": 2000},
    "version_label": {"type": "string", "minLength": 1, "maxLength": 64},
    "document_number": {"type": "string", "minLength": 1, "maxLength": 100},
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": "string", "format": "date-time"},
    "source_status": {
      "type": "string",
      "enum": ["CURRENT", "SUPERSEDED", "EXPIRED", "SYNTHETIC"]
    },
    "locator": {"$ref": "#/$defs/locator"},
    "quote": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional short evidence excerpt; never a substitute for locator resolution."
    }
  },
  "$defs": {
    "uuidV7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "section_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "page_start": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "paragraph_id": {"type": "string", "minLength": 1, "maxLength": 100}
      },
      "allOf": [
        {
          "if": {"required": ["page_end"]},
          "then": {"required": ["page_start"]}
        }
      ]
    }
  }
}
